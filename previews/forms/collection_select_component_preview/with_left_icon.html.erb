<% objects = [OpenStruct.new(name: "Lorem", id: 1), OpenStruct.new(name: "Ipsum", id: 2)] %>

<%= form_with model: model do |form| %>
  <%= form.label :attribute, label %>
  <%= form.collection_select :attribute, objects, :id, :name, left_section: icon("sparkles", variant: :mini, options: {class: "size-5 text-muted-foreground"}) %>
<% end %>
