<div class="flex max-w-md flex-col gap-8">
  <section class="flex flex-col gap-3">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Plain modal</h2>

    <%= render AtomicView::Components::ButtonComponent.new(nil, "Open modal", {
      variant: :outline,
      onclick: "document.getElementById('example-modal').showModal()"
    }) %>

    <%= render AtomicView::Components::ModalComponent.new(id: "example-modal", title: "Update your plan") do |modal| %>
      <p>You're currently on the Free plan. Upgrading gives you unlimited projects and priority support.</p>

      <% modal.with_footer do %>
        <%= render AtomicView::Components::ButtonComponent.new(nil, "Cancel", {
          variant: :outline,
          data: {action: "click->atomic-view--modal#close"}
        }) %>
        <%= render AtomicView::Components::ButtonComponent.new(nil, "Upgrade", {variant: :primary}) %>
      <% end %>
    <% end %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Danger / delete-confirmation modal</h2>

    <%= render AtomicView::Components::ButtonComponent.new(nil, "Delete project", {
      variant: :destructive,
      onclick: "document.getElementById('delete-modal').showModal()"
    }) %>

    <%= render AtomicView::Components::ModalComponent.new(id: "delete-modal", title: "Delete project?", danger: true) do |modal| %>
      <p>This will permanently delete the project and all of its data. This action cannot be undone.</p>

      <% modal.with_footer do %>
        <%= render AtomicView::Components::ButtonComponent.new(nil, "Cancel", {
          variant: :outline,
          data: {action: "click->atomic-view--modal#close"}
        }) %>
        <%= render AtomicView::Components::ButtonComponent.new(nil, "Delete", {variant: :destructive}) %>
      <% end %>
    <% end %>
  </section>

  <section class="flex flex-col gap-2">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Host app setup</h2>
    <p class="text-sm text-muted-foreground">
      The gem cannot register a controller into a host app's own Stimulus
      <code>Application</code> instance. Add this to the host app's
      <code>app/javascript/controllers/index.js</code>:
    </p>
    <pre class="overflow-x-auto rounded-btn border border-border bg-offset p-3 text-xs"><code>import ModalController from "atomic_view/controllers/modal_controller"
application.register("atomic-view--modal", ModalController)</code></pre>
    <p class="text-sm text-muted-foreground">
      Opening a modal from elsewhere on the page (a trigger button, a link
      in a table row, etc.) is the host app's concern -- the trigger doesn't
      need to be inside the dialog, so a plain <code>showModal()</code> call
      is simplest:
    </p>
    <pre class="overflow-x-auto rounded-btn border border-border bg-offset p-3 text-xs"><code>&lt;button onclick="document.getElementById('example-modal').showModal()"&gt;
  Open modal
&lt;/button&gt;</code></pre>
    <p class="text-sm text-muted-foreground">
      Elements <em>inside</em> the dialog (like a footer's Cancel button) can
      use a Stimulus action instead, since they're descendants of the
      <code>&lt;dialog&gt;</code> that carries the controller:
    </p>
    <pre class="overflow-x-auto rounded-btn border border-border bg-offset p-3 text-xs"><code>&lt;button data-action="click-&gt;atomic-view--modal#close"&gt;Cancel&lt;/button&gt;</code></pre>
  </section>
</div>
