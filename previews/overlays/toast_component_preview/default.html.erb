<div class="flex max-w-md flex-col gap-8">
  <section class="flex flex-col gap-3">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Variants</h2>

    <%= render AtomicView::Components::ToastComponent.new(
      variant: :success,
      title: "Changes saved",
      description: "Your profile has been updated."
    ) %>

    <%= render AtomicView::Components::ToastComponent.new(
      variant: :error,
      title: "Something went wrong",
      description: "We couldn't save your changes. Please try again."
    ) %>

    <%= render AtomicView::Components::ToastComponent.new(
      variant: :info,
      title: "Heads up",
      description: "Your session will expire in 5 minutes."
    ) %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Without a dismiss button</h2>

    <%= render AtomicView::Components::ToastComponent.new(
      variant: :info,
      title: "Syncing in the background",
      dismissible: false
    ) %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Auto-dismissing after 4 seconds</h2>

    <%= render AtomicView::Components::ToastComponent.new(
      variant: :success,
      title: "Copied to clipboard",
      auto_dismiss_ms: 4000
    ) %>
  </section>

  <section class="flex flex-col gap-2">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Host app setup</h2>
    <p class="text-sm text-muted-foreground">
      The gem cannot register a controller into a host app's own Stimulus
      <code>Application</code> instance. Add this to the host app's
      <code>app/javascript/controllers/index.js</code>:
    </p>
    <pre class="overflow-x-auto rounded-btn border border-border bg-offset p-3 text-xs"><code>import ToastController from "atomic_view/controllers/toast_controller"
application.register("atomic-view--toast", ToastController)</code></pre>
    <p class="text-sm text-muted-foreground">
      Multiple toasts are stacked by the host app, not this component --
      wrap however many <code>ToastComponent</code>s you render in a plain
      fixed-position container, e.g.:
    </p>
    <pre class="overflow-x-auto rounded-btn border border-border bg-offset p-3 text-xs"><code>&lt;div class="fixed bottom-4 right-4 flex flex-col-reverse gap-2 z-50"&gt;
  &lt;%= render AtomicView::Components::ToastComponent.new(title: "Saved") %&gt;
&lt;/div&gt;</code></pre>
  </section>
</div>
