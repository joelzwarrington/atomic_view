<div class="flex max-w-md flex-col gap-8">
  <section class="flex flex-col gap-3">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Org / park switcher</h2>

    <%= render AtomicView::Components::DropdownComponent.new do |dropdown| %>
      <% dropdown.with_trigger do %>
        <button type="button" class="flex items-center gap-2 rounded-btn border border-border bg-surface px-3 py-2 text-sm font-medium text-foreground hover:bg-offset">
          <%= render AtomicView::Components::AvatarComponent.new(initials: "AP", size: :sm) %>
          Acme Park
          <%= icon("chevron-down", variant: :mini, options: {class: "size-4 text-muted-foreground"}).to_s.html_safe %>
        </button>
      <% end %>

      <% dropdown.with_menu do %>
        <div class="w-64 p-1">
          <p class="px-2 pb-1 pt-2 text-xs uppercase text-muted-foreground">Your organizations</p>

          <a href="#" class="flex items-center justify-between rounded-btn px-2 py-1.5 text-sm text-foreground hover:bg-offset">
            <span class="flex items-center gap-2">
              <%= render AtomicView::Components::AvatarComponent.new(initials: "AP", size: :sm) %>
              Acme Park
            </span>
            <%= icon("check", variant: :mini, options: {class: "size-4 text-primary"}).to_s.html_safe %>
          </a>

          <a href="#" class="flex items-center gap-2 rounded-btn px-2 py-1.5 text-sm text-foreground hover:bg-offset">
            <%= render AtomicView::Components::AvatarComponent.new(initials: "SM", size: :sm) %>
            Summit Meadows
          </a>

          <a href="#" class="flex items-center gap-2 rounded-btn px-2 py-1.5 text-sm text-foreground hover:bg-offset">
            <%= render AtomicView::Components::AvatarComponent.new(initials: "RC", size: :sm) %>
            Ridgeline Campground
          </a>

          <hr class="my-1 border-border">

          <p class="px-2 pb-1 pt-2 text-xs uppercase text-muted-foreground">Account</p>

          <a href="#" class="block rounded-btn px-2 py-1.5 text-sm text-foreground hover:bg-offset">Settings</a>
          <a href="#" class="block rounded-btn px-2 py-1.5 text-sm text-destructive hover:bg-offset">Sign out</a>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Notification bell flyout</h2>

    <%= render AtomicView::Components::DropdownComponent.new do |dropdown| %>
      <% dropdown.with_trigger do %>
        <button type="button" aria-label="Notifications" class="relative inline-flex items-center justify-center rounded-full border border-border bg-surface p-2 text-muted-foreground hover:bg-offset">
          <%= icon("bell", options: {class: "size-5"}).to_s.html_safe %>
          <%= render AtomicView::Components::BadgeComponent.new(variant: :destructive, class: "absolute -right-1 -top-1 px-1.5 py-0 text-[10px]") do %>3<% end %>
        </button>
      <% end %>

      <% dropdown.with_menu do %>
        <div class="w-80 p-1">
          <p class="px-2 pb-1 pt-2 text-xs uppercase text-muted-foreground">Notifications</p>

          <a href="#" class="flex flex-col gap-0.5 rounded-btn px-2 py-2 text-sm hover:bg-offset">
            <span class="font-medium text-foreground">New booking request</span>
            <span class="text-xs text-muted-foreground">Campsite 14 requested for Sept 20-22.</span>
          </a>

          <a href="#" class="flex flex-col gap-0.5 rounded-btn px-2 py-2 text-sm hover:bg-offset">
            <span class="font-medium text-foreground">Payment received</span>
            <span class="text-xs text-muted-foreground">Invoice #1042 was paid in full.</span>
          </a>

          <a href="#" class="flex flex-col gap-0.5 rounded-btn px-2 py-2 text-sm hover:bg-offset">
            <span class="font-medium text-foreground">Maintenance reminder</span>
            <span class="text-xs text-muted-foreground">Water hookup at site 7 needs inspection.</span>
          </a>

          <hr class="my-1 border-border">

          <a href="#" class="block rounded-btn px-2 py-1.5 text-center text-sm text-primary hover:bg-offset">View all notifications</a>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="flex flex-col gap-2">
    <h2 class="font-body text-sm font-semibold text-muted-foreground">Host app setup</h2>
    <p class="text-sm text-muted-foreground">
      The gem cannot register a controller into a host app's own Stimulus
      <code>Application</code> instance. Add this to the host app's
      <code>app/javascript/controllers/index.js</code>:
    </p>
    <pre class="overflow-x-auto rounded-btn border border-border bg-offset p-3 text-xs"><code>import DropdownController from "atomic_view/controllers/dropdown_controller"
application.register("atomic-view--dropdown", DropdownController)</code></pre>
    <p class="text-sm text-muted-foreground">
      Positioning uses <code>@floating-ui/dom</code>, pinned via importmap.
      <code>bin/rails atomic_view:install</code> (the install generator)
      adds the pin to the host app's <code>config/importmap.rb</code>
      automatically -- no manual step needed:
    </p>
    <pre class="overflow-x-auto rounded-btn border border-border bg-offset p-3 text-xs"><code>pin "@floating-ui/dom", to: "https://cdn.jsdelivr.net/npm/@floating-ui/dom@1.8.0/+esm"</code></pre>
  </section>
</div>
