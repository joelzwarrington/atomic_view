<div class="w-72 rounded-card border border-border bg-surface">
  <%= render AtomicView::Components::EmptyStateComponent.new(title: title, description: description.presence) do |component| %>
    <% component.with_icon do %>
      <%= heroicon(icon_name, variant: :outline, options: {class: "size-10 text-muted-foreground"}) %>
    <% end %>

    <% if action_text.present? %>
      <%= form_with model: AtomicView::Model.new, url: "#", method: :get do |form| %>
        <%= form.button action_text, variant: :primary %>
      <% end %>
    <% end %>
  <% end %>
</div>
