<div class="max-w-xs">
  <%= render AtomicView::Components::NavigationTreeComponent.new(label: "Products") do |tree| %>
    <% tree.with_item(label: "Overview", href: "#", icon: "home", active: true) %>

    <% tree.with_item(label: "Connect", icon: "square-3-stack-3d") do |connect| %>
      <% connect.with_item(label: "Overview", href: "#") %>
      <% connect.with_item(label: "Connected accounts", href: "#") %>
      <% connect.with_item(label: "Compliance", href: "#") %>
      <% connect.with_item(label: "Tax forms", href: "#") %>
    <% end %>

    <% tree.with_item(label: "Payments", href: "#", icon: "wallet") %>

    <% tree.with_item(label: "Billing", icon: "credit-card") do |billing| %>
      <% billing.with_item(label: "Invoices", href: "#") %>
      <% billing.with_item(label: "Subscriptions", href: "#") %>
    <% end %>

    <% tree.with_item(label: "Reporting", href: "#", icon: "chart-bar", title: "Reporting") %>
  <% end %>
</div>
