<%= tag.div(**@options.except(:class), class: html_class) do %>
  <%= icon if icon? %>
  <p class="font-body font-semibold text-base"><%= title %></p>
  <% if description.present? %>
    <p class="text-muted-foreground text-sm"><%= description %></p>
  <% end %>
  <% if content? %>
    <%= content %>
  <% end %>
<% end %>
